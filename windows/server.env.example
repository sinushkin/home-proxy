# Настройки службы homeproxy-server на Windows (формат KEY=VALUE, как .env).
# Относительные пути считаются от каталога этого файла.
# Один STUN-сервер или несколько через запятую: ip:порт,ip2:порт.
STUN_ADDR=203.0.113.10:3499
MQTT_ADDR=203.0.113.10:8883
MQTT_CA=ca.crt

# GUID службы (PC_ID) и GUID телефона (PHONE_ID) — из wireguard/out/guids.env.
MY_ID=
PEER_ID=

# У службы нет консоли, поэтому логи — в файл (относительно этого каталога).
LOG_FILE=server.log
# RUST_LOG=server=debug,connection=info

# WG_ADDR=127.0.0.1:51820
# CLIENT_TIMEOUT_SECS=300
