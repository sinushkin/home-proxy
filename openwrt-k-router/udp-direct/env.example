# Копия в udp-direct/env (не коммитится, если содержит адреса). Все значения — по умолчанию в up.sh.
# UDP_DIRECT_PORTS=1025-65535   # какие UDP из LAN идут напрямую через WAN
# DIRECT_MARK=0x2               # метка пакетов (не пересекается с метками других правил)
# DIRECT_TABLE=200              # таблица маршрутов для помеченного трафика
# LAN_IF=br-lan                 # LAN-бридж
# WAN_IF=eth0.2                 # WAN (по умолчанию — из uci network.wan.device)
