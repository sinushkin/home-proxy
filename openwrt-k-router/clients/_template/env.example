# Шаблон клиента (копия на роутер: /root/env.sh или udp-direct/env). Без адресов и ключей —
# их держит setup/vps-client.sh и setup/state (локально, не в git).
CLIENT_NAME=rNNN              # имя клиента (как в clients.txt на сервере — по GUID, здесь просто метка)
UDP_DIRECT_PORTS=1025-65535   # UDP из LAN напрямую через WAN (торренты, игры); остальное — в туннель
# VPS_SERVER — в /etc/vps-client/vps-client.conf (его пишет setup/vps-client.sh)
