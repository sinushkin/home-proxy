# Адреса и идентичность для peer/run.sh. Скопируйте в .env и заполните.
# Относительные пути — от каталога, где лежит run.sh.
# Один STUN-сервер или несколько через запятую: ip:порт,ip2:порт (пир стучится по всем
# увиденным адресам). STUN должен идти тем же маршрутом, что и трафик к пиру.
STUN_ADDR=203.0.113.10:3499
MQTT_ADDR=203.0.113.10:8883
MQTT_CA=../../cert/out/ca.crt

# Мой GUID и GUID пира, которого ищу (у второй стороны они меняются местами).
# Новый GUID: cat /proc/sys/kernel/random/uuid
MY_PEER_ID=
PEER_ID=

# Уровень логов наших крейтов: info | debug (по умолчанию debug).
# LOG_LEVEL=info
# Полная строка RUST_LOG, если нужна (главнее LOG_LEVEL).
# RUST_LOG=peer=debug,connection=info
