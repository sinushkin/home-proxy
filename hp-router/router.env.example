# Настройки hp-router: router.env рядом с бинарником (или --config путь). Относительные
# пути — от каталога этого файла. Полные GUID — секрет пары: этот файл никому не отдавать.

# VPS с белым IP: адрес (порт знакомства по умолчанию 40000), GUID роутера и сервера.
VPS_SERVER=203.0.113.30:40000
VPS_MY_ID=
VPS_PEER_ID=

# Интерфейс туннеля (адрес и DNS выдаёт VPS).
# TUN_NAME=hp0
# TUN_MTU=1400

# Для телефонов: рандеву (STUN — один или несколько через запятую, MQTT по TLS).
STUN_ADDR=203.0.113.10:3499
MQTT_ADDR=203.0.113.10:8883
MQTT_CA=ca.crt

# Телефоны: для каждого свой набор из 10 дыр и своя пара GUID; нумерация подряд с 1 (до 255).
# Номер n — это client_id: под ним VPS закрепляет за телефоном адрес в туннеле.
# GUID роутера (VPS_MY_ID и все PHONE_<n>_MY_ID) должны быть разными.
PHONE_1_MY_ID=
PHONE_1_PEER_ID=
# PHONE_2_MY_ID=
# PHONE_2_PEER_ID=

# Логи: RUST_LOG (по умолчанию info), LOG_TARGET=syslog — в syslog (logread), LOG_FILE=путь.
# RUST_LOG=hp_router=info,hp_tun=info,connection=info
# RUNTIME=multi   # многопоточный tokio (по умолчанию однопоточный: на одноядерном роутере быстрее)
