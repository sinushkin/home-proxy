#!/bin/sh /etc/rc.common
# hp-router (home-proxy): шлюз дома к VPS и пир для телефонов. Настройки — /etc/hp-router/router.env
# (относительные пути в нём — от /etc/hp-router). Автозапуск: /etc/init.d/hp-router enable.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/hp-router
CONF=/etc/hp-router/router.env

start_service() {
	[ -f "$CONF" ] || { echo "hp-router: нет $CONF" >&2; return 1; }
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
