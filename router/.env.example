# Настройки router для router/run.sh. Скопируйте в .env и заполните.
# Относительные пути — от каталога, где лежит run.sh.
# Один STUN-сервер или несколько через запятую: ip:порт,ip2:порт (пир стучится по всем
# увиденным адресам). STUN должен идти тем же маршрутом, что и трафик к пиру.
STUN_ADDR=203.0.113.10:3499
MQTT_ADDR=203.0.113.10:8883
MQTT_CA=../cert/out/ca.crt

# Набор дыр «к серверу»: мой GUID и GUID сервера.
SERVER_MY_ID=
SERVER_PEER_ID=

# Телефоны: для каждого свой набор из 10 дыр и своя пара GUID. Нумерация
# подряд с 1 (до 255); номер n — это client_id, по которому сервер и роутер
# различают телефоны. Мои GUID (SERVER_MY_ID и все PHONE_<n>_MY_ID) должны быть
# разными: брокер различает клиентов по client_id (= мой GUID).
PHONE_1_MY_ID=
PHONE_1_PEER_ID=
# PHONE_2_MY_ID=
# PHONE_2_PEER_ID=

# Уровень логов наших крейтов: info | debug | trace (по умолчанию info).
# LOG_TARGET=syslog        # писать в syslog (OpenWrt: logread)
# LOG_LEVEL=debug
# RUST_LOG=router=info,connection=debug
