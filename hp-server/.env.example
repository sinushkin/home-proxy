# Настройки server для hp-server/run.sh. Скопируйте в .env и заполните.
# Относительные пути — от каталога, где лежит run.sh.
# Один STUN-сервер или несколько через запятую: ip:порт,ip2:порт (пир стучится по всем
# увиденным адресам). STUN должен идти тем же маршрутом, что и трафик к пиру.
STUN_ADDR=203.0.113.10:3499
MQTT_ADDR=203.0.113.10:8883
MQTT_CA=../cert/out/ca.crt

# Мой GUID и GUID роутера (это SERVER_MY_ID роутера — набор «server»).
# У роутера в его .env: SERVER_MY_ID=<роутер>, SERVER_PEER_ID=<мой GUID>.
MY_ID=
PEER_ID=

# WireGuard, куда сервер передаёт пакеты клиентов (по умолчанию 127.0.0.1:51820).
# WG_ADDR=127.0.0.1:51820
# Через сколько секунд тишины клиент удаляется (по умолчанию 300).
# CLIENT_TIMEOUT_SECS=300

# Логи: info | debug | trace (по умолчанию info); LOG_TARGET=syslog — в syslog;
# LOG_FILE=server.log — в файл (путь относительно файла настроек).
# LOG_LEVEL=debug
# RUST_LOG=server=info,connection=debug
