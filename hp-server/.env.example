# Настройки hp-server для hp-server/run.sh. Скопируйте в .env и заполните.
# Относительные пути — от каталога, где лежит run.sh.
# Один STUN-сервер или несколько через запятую: ip:порт,ip2:порт (пир стучится по всем
# увиденным адресам). STUN должен идти тем же маршрутом, что и трафик к пиру.
STUN_ADDR=203.0.113.10:3499
MQTT_ADDR=203.0.113.10:8883
MQTT_CA=../cert/out/ca.crt

# GUID этого ПК и GUID телефона (или роутера OpenWrt, если телефоны за ним).
MY_ID=
PEER_ID=

# Адрес ПК в туннеле и подсеть клиентов (по умолчанию 10.80.0.1/16); адреса телефонам ПК выдаёт
# сам (книга — ADDRESS_FILE, по умолчанию addresses.state), вместе с DNS (по умолчанию —
# резолверы ПК, в конце 8.8.8.8 и 1.1.1.1).
# TUN_ADDR=10.80.0.1/16
# DNS=192.168.1.1
# Несколько телефонов: PEER_1_MY_ID/PEER_1_PEER_ID, PEER_2_…, у каждого свой GUID ПК.
# TUN_NAME=hp0
# TUN_MTU=1400

# Логи: info | debug | trace (по умолчанию info); LOG_TARGET=syslog — в syslog;
# LOG_FILE=server.log — в файл (путь относительно файла настроек).
# LOG_LEVEL=debug
# RUST_LOG=hp_server=info,hp_tun=info,connection=debug
